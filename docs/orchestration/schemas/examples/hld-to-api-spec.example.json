{
  "from": "solution-architect",
  "to": ["python-backend-engineer", "api-testing-engineer"],
  "context_budget_tokens": 5000,
  "input": {
    "hld_interface_contracts": {
      "/context/assemble": {
        "POST": {
          "purpose": "Assemble a budget-fitted, provenance-carrying context slice",
          "auth_scope": "context:read"
        }
      },
      "/memory/write": {
        "POST": {
          "purpose": "Write one memory item, returns 202 + write_id",
          "auth_scope": "memory:write"
        }
      }
    },
    "data_ownership_map": "docs/phase-1-architecture/HLD.md#section-7-interface-contracts-and-endpoint-inventory-input-to-phase-15"
  },
  "output": {
    "openapi_spec": "docs/phase-1.5-api/openapi.yaml",
    "openapi_version": "3.1.0",
    "endpoints": {
      "/context/assemble": {
        "POST": {
          "operation_id": "assembleContext",
          "fr_refs": ["FR-009", "FR-006", "FR-007"]
        }
      },
      "/memory/write": {
        "POST": {
          "operation_id": "writeMemory",
          "fr_refs": ["FR-009", "FR-010"]
        }
      }
    },
    "error_catalog": "error_catalog.json",
    "pagination_contracts": "pagination_contracts.json"
  },
  "assumes": "sync REST/gRPC read path, async write path (per Team Alignment section)",
  "must_not": "introduce new endpoints not traceable to an HLD component"
}
