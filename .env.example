# Shape B deployment env config (DASH-STORY-024, FR-015).
#
# Copy this file to `.env` (gitignored -- never commit the copy) and replace
# every placeholder below with a real, randomly generated, non-default value.
# `docker-compose.yml` and `dashanan.infrastructure.settings` both read these
# exact variable names. Nothing in this repository hardcodes a credential
# anywhere else (application-security-core / cloud-security-core: never
# hardcode secrets, never commit them).
#
# Generate a strong random value for each placeholder, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- PostgreSQL (ADR-006; Zones 2/3/4/5/7) -----------------------------------
DASHANAN_POSTGRES_HOST=localhost
DASHANAN_POSTGRES_PORT=5432
DASHANAN_POSTGRES_DATABASE=dashanan

# The migration role: connects to apply every zone schema .sql file and to
# perform the brief dashanan_schema_owner membership grant/revoke each file's
# own DDL already implements. Requires CREATEROLE-level privilege.
DASHANAN_POSTGRES_MIGRATION_USER=REPLACE_WITH_A_REAL_MIGRATION_USERNAME
DASHANAN_POSTGRES_MIGRATION_PASSWORD=REPLACE_WITH_A_REAL_RANDOM_PASSWORD

# The application's real login role: the migration runner creates/updates
# this role and grants it membership in dashanan_provenance_role and
# dashanan_episodic_role (AC-024-2). The composition root's real adapters
# connect as this role, never as the migration role.
DASHANAN_POSTGRES_APP_USER=REPLACE_WITH_A_REAL_APP_USERNAME
DASHANAN_POSTGRES_APP_PASSWORD=REPLACE_WITH_A_REAL_RANDOM_PASSWORD

# --- Redis (ADR-005; Zone 1 hot store + event bus) --------------------------
DASHANAN_REDIS_HOST=localhost
DASHANAN_REDIS_PORT=6379
DASHANAN_REDIS_PASSWORD=REPLACE_WITH_A_REAL_RANDOM_PASSWORD

# --- Qdrant (ADR-007; Zone 6 vector index) -----------------------------------
DASHANAN_QDRANT_HOST=localhost
DASHANAN_QDRANT_PORT=6333
DASHANAN_QDRANT_GRPC_PORT=6334
DASHANAN_QDRANT_API_KEY=REPLACE_WITH_A_REAL_RANDOM_API_KEY

# --- OpenSearch (ADR-008; Zone 6 lexical index) ------------------------------
DASHANAN_OPENSEARCH_HOST=localhost
DASHANAN_OPENSEARCH_PORT=9200
DASHANAN_OPENSEARCH_USERNAME=admin
# OpenSearch's own security plugin rejects a weak/default admin password at
# container startup -- this must be a strong, non-default value.
DASHANAN_OPENSEARCH_PASSWORD=REPLACE_WITH_A_REAL_STRONG_PASSWORD

# --- S3-compatible object store / MinIO (ADR-009; Zone 8) --------------------
DASHANAN_S3_ENDPOINT_URL=http://localhost:9000
DASHANAN_S3_PORT=9000
DASHANAN_S3_CONSOLE_PORT=9001
DASHANAN_S3_ACCESS_KEY=REPLACE_WITH_A_REAL_ACCESS_KEY
DASHANAN_S3_SECRET_KEY=REPLACE_WITH_A_REAL_RANDOM_SECRET_KEY
DASHANAN_S3_BUCKET=dashanan-zone8
